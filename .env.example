# ── Ingestion HTTP Service ──────────────────────────────────────────────────
PORT=8080

# ── Redis Stream Buffer ─────────────────────────────────────────────────────
# When running locally against a bare process use localhost:6379.
# When running inside Docker Compose use the service name: redis:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
RAW_STREAM_NAME=raw_events
CONSUMER_GROUP=ulpf-worker-group
CONSUMER_NAME=worker-1

# Approximate maximum number of entries kept in the Redis stream.
# 0 = unlimited (not recommended in production).
RAW_EVENT_STREAM_MAXLEN=100000

# ── Worker Batching ─────────────────────────────────────────────────────────
# Number of messages fetched per ReadGroup / ClaimPending call.
WORKER_BATCH_SIZE=10

# ── Redis Crash Recovery ─────────────────────────────────────────────────────
# Pending-message idle threshold in milliseconds before XAUTOCLAIM reclaims it.
# Messages idle longer than this are considered orphaned by a crashed worker.
# Set to 0 to disable crash recovery (not recommended).
RAW_EVENT_CLAIM_IDLE_MS=60000

# ── Redis Idempotency ────────────────────────────────────────────────────────
# Processing lock TTL in seconds (SET NX). If a worker crashes while processing,
# the lock automatically expires after this duration, allowing recovery.
IDEMPOTENCY_LOCK_TTL_S=120

# Completed event marker TTL in seconds. Duplicate deliveries within this
# window are safely skipped and acknowledged. Default: 86400 (24 hours).
IDEMPOTENCY_DONE_TTL_S=86400

# ── MinIO / S3 Immutable Raw Event Store ────────────────────────────────────
# When running inside Docker Compose use the service name: minio:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_USE_SSL=false
MINIO_BUCKET=raw-events
