  "title": "RawEvent",
  "description": "ULPF Raw Event Ingestion Contract",
  "type": "object",
  "required": [
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "received_at": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
